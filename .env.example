DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,tu-dominio.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.cl,https://www.tu-dominio.cl
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
UOCT_MAX_UPLOAD_MB=100
DB_CONN_MAX_AGE=60

# Opcional para deploy sin consola/SSH: crea o actualiza el primer admin al iniciar.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_DISPLAY_NAME=Administrador

# SQLite local por defecto. Para PostgreSQL, descomenta/configura:
# DATABASE_URL=postgresql://uoct_user:change-me@localhost:5432/uoct
# POSTGRES_DB=uoct
# POSTGRES_USER=uoct_user
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
